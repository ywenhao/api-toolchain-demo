{
  "components": {
    "schemas": {
      "demo.model.v1.Task": {
        "description": "Task 是任务数据；时间使用 RFC 3339 JSON 字符串。",
        "properties": {
          "completed": {
            "type": "boolean"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "type": "object"
      },
      "demo.model.v1.TaskEvent": {
        "description": "单帧 data 的 JSON 结构，对应 api/demo/model/v1/tasks.proto 的 TaskEvent；不是整个 HTTP 响应的结构。",
        "properties": {
          "eventId": {
            "type": "string"
          },
          "occurredAt": {
            "format": "date-time",
            "type": "string"
          },
          "task": {
            "$ref": "#/components/schemas/demo.model.v1.Task"
          },
          "type": {
            "enum": [
              "task.created",
              "task.updated",
              "task.deleted"
            ],
            "type": "string"
          }
        },
        "required": [
          "eventId",
          "type",
          "task",
          "occurredAt"
        ],
        "type": "object"
      },
      "demo.user.v1.CreateTaskRequest": {
        "properties": {
          "description": {
            "description": "描述，最多 1000 个字符。",
            "maxLength": 1000,
            "type": "string"
          },
          "title": {
            "description": "标题，去除首尾空白后 1～120 个字符。",
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "title"
        ],
        "type": "object"
      },
      "demo.user.v1.CreateTaskResponse": {
        "properties": {
          "task": {
            "$ref": "#/components/schemas/demo.model.v1.Task"
          }
        },
        "type": "object"
      },
      "demo.user.v1.DeleteTaskResponse": {
        "properties": {
          "deleted": {
            "type": "boolean"
          },
          "id": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "demo.user.v1.GetTaskResponse": {
        "properties": {
          "task": {
            "$ref": "#/components/schemas/demo.model.v1.Task"
          }
        },
        "type": "object"
      },
      "demo.user.v1.ListTasksResponse": {
        "properties": {
          "tasks": {
            "items": {
              "$ref": "#/components/schemas/demo.model.v1.Task"
            },
            "type": "array"
          },
          "total": {
            "format": "uint32",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "demo.user.v1.UpdateTaskRequest": {
        "properties": {
          "completed": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "demo.user.v1.UpdateTaskResponse": {
        "properties": {
          "task": {
            "$ref": "#/components/schemas/demo.model.v1.Task"
          }
        },
        "type": "object"
      },
      "google.protobuf.Any": {
        "additionalProperties": true,
        "description": "Contains an arbitrary serialized message along with a @type that describes the type of the serialized message.",
        "properties": {
          "@type": {
            "description": "The type of the serialized message.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "google.rpc.Status": {
        "description": "The `Status` type defines a logical error model that is suitable for different programming environments, including REST APIs and RPC APIs. It is used by [gRPC](https://github.com/grpc). Each `Status` message contains three pieces of data: error code, error message, and error details. You can find out more about this error model and how to work with it in the [API Design Guide](https://cloud.google.com/apis/design/errors).",
        "properties": {
          "code": {
            "description": "The status code, which should be an enum value of [google.rpc.Code][google.rpc.Code].",
            "format": "int32",
            "type": "integer"
          },
          "details": {
            "description": "A list of messages that carry the error details.  There is a common set of message types for APIs to use.",
            "items": {
              "$ref": "#/components/schemas/google.protobuf.Any"
            },
            "type": "array"
          },
          "message": {
            "description": "A developer-facing error message, which should be in English. Any user-facing error message should be localized and sent in the [google.rpc.Status.details][google.rpc.Status.details] field, or localized by the client.",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Go + Buf + gRPC-Gateway 示例。任务接口由 proto 生成；SSE 与健康检查通过受控文档片段合并。数据只保存在内存，重启后清空。",
    "title": "Proto API Lab · 用户端",
    "version": "1.0.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "Health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "service": {
                      "example": "proto-api-lab",
                      "type": "string"
                    },
                    "status": {
                      "example": "ok",
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "service"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "HTTP 服务可用"
          }
        },
        "summary": "健康检查",
        "tags": [
          "系统"
        ]
      }
    },
    "/user/v1/events": {
      "get": {
        "description": "真实的 text/event-stream 长连接。先发送 ready，之后发送 task.created、task.updated、task.deleted；每 10 秒发送注释心跳。支持 Last-Event-ID 或 last_event_id 查询参数重放最近 128 条事件。事件历史过期或服务重启后游标超出范围时发送 reset，客户端重新拉取列表。Swagger 的 Try it out 不适合持续流，请使用首页的实时面板、EventSource 或 curl -N。",
        "operationId": "SubscribeTaskEvents",
        "parameters": [
          {
            "description": "最后收到的非负整数事件 ID；优先于查询参数。",
            "in": "header",
            "name": "Last-Event-ID",
            "required": false,
            "schema": {
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          },
          {
            "description": "方便浏览器首次连接时指定游标。",
            "in": "query",
            "name": "last_event_id",
            "required": false,
            "schema": {
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "example": "retry: 1000\nevent: ready\ndata: {\"latestEventId\":\"0\",\"replayed\":0}\n\nid: 1\nevent: task.created\ndata: {\"eventId\":\"1\",\"type\":\"task.created\",\"task\":{\"id\":\"task-000001\",\"title\":\"体验 SSE\",\"completed\":false},\"occurredAt\":\"2026-09-14T00:00:00Z\"}\n\n",
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "SSE 流，响应持续保持打开"
          },
          "400": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "游标不是合法的非负整数"
          }
        },
        "summary": "订阅任务变化（SSE）",
        "tags": [
          "实时事件"
        ],
        "x-sse-events": {
          "ready": {
            "description": "订阅已建立；携带 latestEventId 和 replayed。"
          },
          "reset": {
            "description": "游标过期；重新拉取当前端的任务列表以同步状态。"
          },
          "task.created": {
            "$ref": "#/components/schemas/demo.model.v1.TaskEvent"
          },
          "task.deleted": {
            "$ref": "#/components/schemas/demo.model.v1.TaskEvent"
          },
          "task.updated": {
            "$ref": "#/components/schemas/demo.model.v1.TaskEvent"
          }
        }
      }
    },
    "/user/v1/tasks": {
      "get": {
        "description": "ListTasks 按创建顺序分页查询，可筛选完成状态。",
        "operationId": "UserTaskService_ListTasks",
        "parameters": [
          {
            "description": "不传表示查询所有任务；传 false 只查未完成任务。",
            "in": "query",
            "name": "completed",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "description": "默认 20，最大 100。",
            "in": "query",
            "name": "limit",
            "schema": {
              "format": "uint32",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "format": "uint32",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/demo.user.v1.ListTasksResponse"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/google.rpc.Status"
                }
              }
            },
            "description": "Default error response"
          }
        },
        "summary": "查询任务列表",
        "tags": [
          "任务"
        ]
      },
      "post": {
        "description": "CreateTask 创建任务，并向 SSE 订阅者推送 task.created。",
        "operationId": "UserTaskService_CreateTask",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/demo.user.v1.CreateTaskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/demo.user.v1.CreateTaskResponse"
                }
              }
            },
            "description": "任务已创建"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/google.rpc.Status"
                }
              }
            },
            "description": "Default error response"
          }
        },
        "summary": "创建任务",
        "tags": [
          "任务"
        ]
      }
    },
    "/user/v1/tasks/{id}": {
      "delete": {
        "description": "DeleteTask 删除任务，并向 SSE 订阅者推送 task.deleted。",
        "operationId": "UserTaskService_DeleteTask",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/demo.user.v1.DeleteTaskResponse"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/google.rpc.Status"
                }
              }
            },
            "description": "Default error response"
          }
        },
        "summary": "删除任务",
        "tags": [
          "任务"
        ]
      },
      "get": {
        "description": "GetTask 查询单个任务；不存在时返回 HTTP 404。",
        "operationId": "UserTaskService_GetTask",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/demo.user.v1.GetTaskResponse"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/google.rpc.Status"
                }
              }
            },
            "description": "Default error response"
          }
        },
        "summary": "查询任务详情",
        "tags": [
          "任务"
        ]
      },
      "patch": {
        "description": "UpdateTask 部分更新；optional 区分“不修改”和显式传入 false / 空字符串。",
        "operationId": "UserTaskService_UpdateTask",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/demo.user.v1.UpdateTaskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/demo.user.v1.UpdateTaskResponse"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/google.rpc.Status"
                }
              }
            },
            "description": "Default error response"
          }
        },
        "summary": "部分更新任务",
        "tags": [
          "任务"
        ]
      }
    }
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "tags": [
    {
      "description": "由 proto 生成的 HTTP CRUD",
      "name": "任务"
    },
    {
      "description": "原生 HTTP SSE",
      "name": "实时事件"
    },
    {
      "description": "健康检查",
      "name": "系统"
    }
  ]
}
